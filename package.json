{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/navarea-pages/generate-navarea-pages.mjs && VITE_APP_BUILD_TIME=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\") vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/parsers/__tests__/inForceListParser.test.ts",
    "dev:audit": "tsx scripts/ux-audit/dev-server.ts",
    "ux:capture": "tsx scripts/ux-audit/capture.ts",
    "ux:capture:live": "tsx scripts/ux-audit/capture.ts --live",
    "ux:smoke": "playwright test",
    "generate:navarea": "node scripts/navarea-pages/generate-navarea-pages.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.546.0",
    "papaparse": "^5.7.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^4.17.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^13.0.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
