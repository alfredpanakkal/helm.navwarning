{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/about",
      "destination": "/?tab=info",
      "permanent": true
    },
    {
      "source": "/sources",
      "destination": "/?tab=sources",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/navarea/:rn/warning/:slug",
      "destination": "/warning-shell"
    },
    {
      "source": "/api/tiles/carto/:style/:z/:x/:y",
      "destination": "/api/tiles?provider=carto&style=:style&z=:z&x=:x&y=:y"
    },
    {
      "source": "/api/tiles/osm/:z/:x/:y",
      "destination": "/api/tiles?provider=osm&z=:z&x=:x&y=:y"
    },
    {
      "source": "/api/tiles/openseamap/:z/:x/:y",
      "destination": "/api/tiles?provider=openseamap&z=:z&x=:x&y=:y"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/console",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/navarea/:id/warnings.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
