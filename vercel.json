{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/scrape-navwarn",
      "schedule": "0 6 * * *"
    }
  ]
}
