{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/tiles/carto/:style/:z/:x/:y",
      "destination": "/api/tiles?provider=carto&style=:style&z=:z&x=:x&y=:y"
    },
    {
      "source": "/api/tiles/osm/:z/:x/:y",
      "destination": "/api/tiles?provider=osm&z=:z&x=:x&y=:y"
    },
    {
      "source": "/api/tiles/openseamap/:z/:x/:y",
      "destination": "/api/tiles?provider=openseamap&z=:z&x=:x&y=:y"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/console",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/scrape-navwarn",
      "schedule": "0 6 * * *"
    }
  ]
}
